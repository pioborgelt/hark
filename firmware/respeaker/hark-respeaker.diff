--- ../upstream/respeaker/packages/lite/hark-test-sim.yaml	1970-01-01 01:00:00.000000000 +0100
+++ packages/lite/hark-test-sim.yaml	2026-11-17 17:01:49.673190785 +0100
@@ -0,0 +1,59 @@
+# =============================================================================
+# Hark test build — simulation buttons for the ReSpeaker Lite
+#
+# The ReSpeaker Lite has a user button (= Voice PE center button) and a mute
+# button, but no LED ring, no dial and no physical mute slider. These buttons
+# let Home Assistant trigger the same code paths as the real Voice PE inputs.
+# The diagnostics (phase, streaming, ducking) come from hark-streaming.yaml.
+# Only for testing; the Voice PE build does not contain this file.
+# =============================================================================
+
+button:
+  - platform: template
+    id: sim_center_button
+    name: "Sim: center button press"
+    icon: mdi:gesture-tap-button
+    on_press:
+      - script.execute: center_button_single_click
+  - platform: template
+    id: sim_timer_rings
+    name: "Sim: timer rings"
+    icon: mdi:timer-alert
+    on_press:
+      - switch.turn_on: timer_ringing
+  - platform: template
+    id: sim_stop_word
+    name: "Sim: stop word"
+    icon: mdi:hand-back-left
+    on_press:
+      - script.execute:
+          id: device_wake_word_detected
+          wake_word: "Stop"
+  - platform: template
+    id: sim_device_wake_word
+    name: "Sim: on-device wake word (Okay Nabu)"
+    icon: mdi:account-voice
+    on_press:
+      - script.execute:
+          id: device_wake_word_detected
+          wake_word: "Okay Nabu"
+  - platform: template
+    id: sim_announcement
+    name: "Sim: short announcement"
+    icon: mdi:bullhorn
+    on_press:
+      - script.execute:
+          id: play_sound
+          priority: false
+          sound_file: "timer_finished_sound"
+
+# Test diagnostics: Wi-Fi quality and uptime (shows reboots)
+sensor:
+  - platform: wifi_signal
+    name: "Test: Wi-Fi signal"
+    update_interval: 30s
+    entity_category: diagnostic
+  - platform: uptime
+    name: "Test: uptime"
+    update_interval: 30s
+    entity_category: diagnostic
--- ../upstream/respeaker/config/hark-respeaker-test.yaml	1970-01-01 01:00:00.000000000 +0100
+++ config/hark-respeaker-test.yaml	2026-11-17 19:38:46.841800479 +0100
@@ -0,0 +1,79 @@
+# =============================================================================
+# Hark TEST firmware for the ReSpeaker Lite (XIAO ESP32-S3)
+#
+# = formatBCE Respeaker Lite satellite 2026.11.1 (factory config)
+#   + Hark streaming switch ("Wake word engine location")
+#   + simulation buttons and diagnostics for testing
+#
+# Not for daily use. Do not "adopt" it in the ESPHome dashboard: adoption would
+# replace it with the original firmware without the Hark changes.
+# Build: see firmware/README.md
+# =============================================================================
+
+substitutions:
+  respeaker_lite_ref: 2026.11.1
+
+packages:
+  core_base: !include ../packages/core/base.yaml
+  core_voice_assistant: !include ../packages/core/voice-assistant.yaml
+  core_media_player: !include ../packages/core/media-player.yaml
+  core_timers_alarm: !include ../packages/core/timers-alarm.yaml
+  core_controls: !include ../packages/core/controls.yaml
+  respeaker_lite_hardware: !include ../packages/respeaker-lite/hardware.yaml
+  lite_device: !include ../packages/lite/device.yaml
+  hark_streaming: !include ../packages/core/hark-streaming.yaml
+  hark_test_sim: !include ../packages/lite/hark-test-sim.yaml
+  # BLE and Wi-Fi share the radio. Disable BLE while Wi-Fi is up, and wait for
+  # that before the voice assistant starts. (from the factory config)
+  va_connected_wait_for_ble:
+    voice_assistant:
+      on_client_connected:
+        - wait_until:
+            not: ble.enabled
+        - delay: 2s
+    wifi:
+      on_disconnect:
+        - ble.enable:
+
+esphome:
+  name: hark-respeaker-test
+  friendly_name: Hark ReSpeaker Test
+  project:
+    name: hark.respeaker-lite-test
+    version: 2026.11.1-hark2
+
+wifi:
+  on_connect:
+    - delay: 5s
+    - ble.disable:
+    - script.execute: control_leds
+
+ota:
+  - platform: esphome
+    id: ota_esphome
+
+# ESPHome's voice_assistant with the Hark patch (firmware/patch_voice_assistant.py):
+# ignores a RUN_END that belongs to an earlier pipeline run
+external_components:
+  - source:
+      type: local
+      path: ../components
+    components: [voice_assistant]
+
+# Wi-Fi setup over USB (web.esphome.io) or Bluetooth (push the user button to
+# authorize Improv BLE)
+improv_serial:
+
+esp32_ble:
+
+improv_ble:
+  authorizer: user_button
+  on_start:
+    - lambda: id(improv_ble_in_progress) = true;
+    - script.execute: control_leds
+  on_provisioned:
+    - lambda: id(improv_ble_in_progress) = false;
+    - script.execute: control_leds
+  on_stop:
+    - lambda: id(improv_ble_in_progress) = false;
+    - script.execute: control_leds
